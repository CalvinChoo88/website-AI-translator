generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shop {
  id             String    @id @default(cuid())
  // Shop host as returned by EasyStore (host_url on OAuth callback),
  // e.g. "mystore.easystore.co" — also the {shop} used in Admin API calls.
  domain         String    @unique
  accessToken    String
  scope          String
  // Store's own default/source language, e.g. "en".
  sourceLocale   String    @default("en")
  // JSON-encoded string[] of locale codes the merchant has enabled
  // for translation, e.g. ["ms","zh-CN","ja"]. Stored as JSON text
  // rather than a native array column so this schema stays portable
  // across SQLite/Postgres/MySQL.
  enabledLocales String    @default("[]")
  autoDetect     Boolean   @default(true)
  // Opt-in: when a shopper first picks a locale that's never been used
  // on this shop, crawl the storefront in the background and translate
  // every page into it, so later shoppers never hit an uncached page.
  // Off by default — it spends translation-provider quota proactively
  // rather than only for pages someone actually views.
  autoWarmOnFirstUse Boolean   @default(false)
  // "free" | "starter" | "business" | "elite" — see src/lib/plans.ts.
  // Written only by the Stripe webhook (checkout.session.completed /
  // customer.subscription.deleted); never trust a client-set value.
  plan             String    @default("free")
  // Stripe Customer ID, captured on first checkout so a later
  // customer.subscription.deleted event (which has no client_reference_id)
  // can still be matched back to this shop.
  stripeCustomerId String?
  // The active subscription's ID — needed to call Stripe's cancel API
  // directly from /admin/subscription (a Customer ID alone isn't enough
  // to target a specific subscription for cancellation).
  stripeSubscriptionId String?
  // Mirrors the Stripe Subscription's own `status` (e.g. "active",
  // "past_due", "canceled") — synced from customer.subscription.updated.
  subscriptionStatus  String?
  // When the current subscription began (Stripe's fixed `start_date`,
  // not the rolling current-period start) — shown as "Started" on
  // /admin/subscription. Estimated from the checkout itself, then
  // corrected with the authoritative value on the next
  // customer.subscription.updated.
  subscriptionStartDate DateTime?
  // Renewal/expiry date of the current billing period, synced from the
  // same event. Used to show an "expiring soon" reminder before the
  // next charge, and to know when a scheduled cancellation takes effect.
  currentPeriodEnd    DateTime?
  // True once the merchant has scheduled cancellation (e.g. via the
  // Stripe customer portal) — still active until currentPeriodEnd,
  // but won't renew after that.
  cancelAtPeriodEnd   Boolean   @default(false)
  installedAt    DateTime  @default(now())
  uninstalledAt  DateTime?
  updatedAt      DateTime  @updatedAt

  translations Translation[]
  localeWarms  LocaleWarm[]
  cancellationFeedback CancellationFeedback[]
}

// One row per cancellation, kept even across a later resubscribe —
// simple churn-reason history, not tied to the shop's current state.
model CancellationFeedback {
  id        String   @id @default(cuid())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId    String
  plan      String
  reason    String
  createdAt DateTime @default(now())

  @@index([shopId])
}

model Translation {
  id             String   @id @default(cuid())
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId         String
  locale         String
  // sha256 of the trimmed source text, used as the cache key so
  // identical strings (e.g. repeated on many pages) are translated once.
  sourceHash     String
  sourceText     String
  translatedText String
  createdAt      DateTime @default(now())

  @@unique([shopId, locale, sourceHash])
  @@index([shopId, locale])
}

// Tracks a background crawl-and-translate run for one shop+locale,
// triggered by the first shopper who picks that locale (when the shop
// has autoWarmOnFirstUse enabled). One row per shop+locale ever
// warmed — the unique constraint is what stops two shoppers picking
// the same new locale at once from starting duplicate crawls.
model LocaleWarm {
  id           String   @id @default(cuid())
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId       String
  locale       String
  status       String   @default("running") // running | done | failed
  // Same-origin storefront URLs already crawled and queued-but-not-yet
  // crawled, as JSON string[]. A single run is a sequential chain of
  // self-invoking batches (see /api/internal/warm-locale), so this
  // never has concurrent writers.
  visitedJson  String   @default("[]")
  frontierJson String   @default("[]")
  pagesDone    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([shopId, locale])
}
