# --- Database ---
# Postgres connection string, including for local dev (e.g. via
# `docker run -p 5432:5432 postgres`, or a free Neon/Supabase project).
# On Vercel: attach a database from the Storage tab (Vercel Postgres,
# Neon, or Supabase all work). Whichever you pick, it injects its own
# env var name (e.g. POSTGRES_PRISMA_URL, not DATABASE_URL) — copy that
# value into a DATABASE_URL env var in Project Settings so Prisma finds
# it. Prefer the *pooled* connection string if one is offered.
DATABASE_URL="postgresql://user:password@localhost:5432/easystore_translator"

# --- EasyStore Partner app credentials ---
# From Partner Dashboard > Apps > Create app > app overview page.
EASYSTORE_CLIENT_ID=
EASYSTORE_CLIENT_SECRET=
# Comma-separated, no spaces. Confirmed against EasyStore's real scope
# list (there is no "read_store" scope — basic store info via
# store.json needs no special scope). Full valid list: read/write_snippets,
# read/write_script_tags, read/write_customers, read/write_orders,
# read/write_products, read/write_content, read/write_fulfillments,
# read/write_shipping, write_locations, read/write_customer_attributes,
# read_currencies.
EASYSTORE_SCOPES=read_products,read_content

# Public base URL of THIS app (no trailing slash). Must match the
# redirect URL registered in the Partner Dashboard, e.g.:
# https://your-app.vercel.app
APP_URL=http://localhost:3000

# Random 32+ byte secret used to sign the merchant admin session
# cookie issued after OAuth. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Random 32+ byte secret used to authenticate this app's own internal
# background-crawl requests to itself (/api/internal/warm-locale) —
# only needed if a merchant enables "auto-translate the rest of my
# storefront" (autoWarmOnFirstUse) in /admin. Without this set, that
# feature silently no-ops instead of erroring. Generate with:
# openssl rand -hex 32 (use a DIFFERENT value than SESSION_SECRET)
INTERNAL_JOB_SECRET=

# --- Translation provider ---
# "deepl" (default) | "azure" | "google".
# DeepL covers ~35 languages (vs ~130 for Azure/Google) but is
# generally regarded as higher quality for the languages it has.
# The admin's language picker automatically restricts itself to
# whatever the active provider actually supports (unless
# TRANSLATION_FALLBACK_PROVIDER is also set — see below).
TRANSLATION_PROVIDER=deepl

# Optional. Only meaningful when TRANSLATION_PROVIDER=deepl. Set to
# "azure" or "google" to automatically translate any locale DeepL
# doesn't support (its ~35-language limit) using that provider
# instead — DeepL still handles every locale it does support, so this
# is "fill DeepL's gaps" rather than replacing it. Once set, the
# admin's language picker opens up to the full ~130-language catalog
# instead of DeepL's subset. Requires that provider's own API key
# below to also be set.
TRANSLATION_FALLBACK_PROVIDER=

# DeepL — sign up at https://www.deepl.com/pro-api, free tier is
# 500,000 characters/month. Free-tier keys end in ":fx" and only work
# against the free endpoint; the app detects this from the key itself.
DEEPL_API_KEY=

# Azure AI Translator — needed if TRANSLATION_PROVIDER=azure, or if
# TRANSLATION_FALLBACK_PROVIDER=azure. Create a "Translator" resource
# in the Azure portal; free F0 tier is 2M characters/month,
# indefinitely (not a trial). Use a "Global" resource so
# AZURE_TRANSLATOR_REGION can be left blank.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# Needed if TRANSLATION_PROVIDER=google, or if
# TRANSLATION_FALLBACK_PROVIDER=google.
GOOGLE_TRANSLATE_API_KEY=

# --- Geo-IP fallback (used only when not deployed on Vercel, which
# provides geolocation headers natively) ---
GEOIP_FALLBACK_API_URL=https://ipapi.co

# --- Stripe subscription payment links (optional) ---
# Dashboard-created Payment Links (Product catalog > a Price >
# "Create payment link"), one per plan tier. Use the "buy.stripe.com/
# test_..." links while in test mode; swap in the live ones later.
# Leave any of these blank to hide that tier's upgrade button.
# /admin appends ?client_reference_id=<shop domain> itself — don't add
# it here.
STRIPE_PAYMENT_LINK_STARTER=
STRIPE_PAYMENT_LINK_BUSINESS=
STRIPE_PAYMENT_LINK_ELITE=

# The *ID* of each Payment Link above (starts with "plink_"), NOT the
# URL — visible on the link's detail/edit page in the Stripe dashboard.
# Used by /api/webhooks/stripe to figure out which plan a completed
# checkout was for.
STRIPE_PAYMENT_LINK_ID_STARTER=
STRIPE_PAYMENT_LINK_ID_BUSINESS=
STRIPE_PAYMENT_LINK_ID_ELITE=

# Signing secret for the Stripe webhook endpoint (Dashboard > Developers
# > Webhooks > your endpoint > "Signing secret"). Required for
# /api/webhooks/stripe to accept any events — without it, every request
# is rejected with 401 regardless of origin.
STRIPE_WEBHOOK_SECRET=

# Stripe API secret key (Dashboard > Developers > API keys — "Secret
# key", starts with sk_test_/sk_live_). Only needed for the "Cancel
# subscription" button on /admin/subscription, which calls Stripe's API
# directly to cancel; nothing else in this app needs it.
STRIPE_SECRET_KEY=
