# --- Database ---
# Postgres connection string, including for local dev (e.g. via
# `docker run -p 5432:5432 postgres`, or a free Neon/Supabase project).
# On Vercel: attach a database from the Storage tab (Vercel Postgres,
# Neon, or Supabase all work). Whichever you pick, it injects its own
# env var name (e.g. POSTGRES_PRISMA_URL, not DATABASE_URL) — copy that
# value into a DATABASE_URL env var in Project Settings so Prisma finds
# it. Prefer the *pooled* connection string if one is offered.
DATABASE_URL="postgresql://user:password@localhost:5432/easystore_translator"

# --- EasyStore Partner app credentials ---
# From Partner Dashboard > Apps > Create app > app overview page.
EASYSTORE_CLIENT_ID=
EASYSTORE_CLIENT_SECRET=
# Comma-separated, no spaces. Verify exact scope names against
# https://developers.easystore.co/docs/api/getting-started/scopes
# before going live — this app needs read/write access to store
# content it will translate (products, pages) plus basic store info.
EASYSTORE_SCOPES=read_products,read_content,read_store

# Public base URL of THIS app (no trailing slash). Must match the
# redirect URL registered in the Partner Dashboard, e.g.:
# https://your-app.vercel.app
APP_URL=http://localhost:3000

# Random 32+ byte secret used to sign the merchant admin session
# cookie issued after OAuth. Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Translation provider ---
# "deepl" (default) | "azure" | "google".
# DeepL covers ~35 languages (vs ~130 for Azure/Google) but is
# generally regarded as higher quality for the languages it has.
# The admin's language picker automatically restricts itself to
# whatever the active provider actually supports.
TRANSLATION_PROVIDER=deepl

# DeepL — sign up at https://www.deepl.com/pro-api, free tier is
# 500,000 characters/month. Free-tier keys end in ":fx" and only work
# against the free endpoint; the app detects this from the key itself.
DEEPL_API_KEY=

# Azure AI Translator — only needed if TRANSLATION_PROVIDER=azure.
# Create a "Translator" resource in the Azure portal; free F0 tier is
# 2M characters/month, indefinitely (not a trial). Use a "Global"
# resource so AZURE_TRANSLATOR_REGION can be left blank.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# Only needed if TRANSLATION_PROVIDER=google.
GOOGLE_TRANSLATE_API_KEY=

# --- Geo-IP fallback (used only when not deployed on Vercel, which
# provides geolocation headers natively) ---
GEOIP_FALLBACK_API_URL=https://ipapi.co
